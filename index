<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>Яндекс</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

html, body {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: fixed;
    top: 0;
    left: 0;
    background: #fff;
    font-family: -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
    user-select: none;
    touch-action: none;
    overscroll-behavior: none;
}

/* ============================================================
   ЭКРАН COOKIE В СТИЛЕ ЯНДЕКСА
   ============================================================ */
#cookie {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: #fff;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 40px 30px;
    z-index: 100;
    text-align: center;
}

#cookie .logo {
    width: 120px;
    height: auto;
    margin-bottom: 35px;
}

#cookie h1 {
    font-size: 26px;
    color: #000;
    margin-bottom: 20px;
    font-weight: 700;
    font-family: 'Yandex Sans', Arial, sans-serif;
}

#cookie p {
    font-size: 15px;
    color: #333;
    line-height: 1.6;
    max-width: 520px;
    margin-bottom: 12px;
}

#cookie p a {
    color: #000;
    text-decoration: underline;
}

#cookie button {
    background: #fc3f1d;
    color: #fff;
    border: none;
    border-radius: 8px;
    padding: 16px 60px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    margin-top: 30px;
    transition: background 0.2s;
    font-family: 'Yandex Sans', Arial, sans-serif;
}

#cookie button:hover {
    background: #e6361a;
}

#cookie .small {
    font-size: 12px;
    color: #999;
    margin-top: 18px;
    max-width: 400px;
}

#cookie .small a {
    color: #999;
    text-decoration: underline;
}

/* ============================================================
   ЛИЦО ДЖЕФФА
   ============================================================ */
#jeff {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    object-fit: cover;
    display: none;
    z-index: 9999;
}

@keyframes invertFlash {
    0% { filter: invert(0); }
    50% { filter: invert(1); }
    100% { filter: invert(0); }
}

.flash {
    animation: invertFlash 0.2s steps(1) infinite;
}

/* ============================================================
   ТРЯСКА
   ============================================================ */
@keyframes shake {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-3px, 3px); }
    50% { transform: translate(3px, -3px); }
    75% { transform: translate(-3px, -3px); }
    100% { transform: translate(3px, 3px); }
}

.shake {
    animation: shake 0.08s infinite;
}
</style>
</head>
<body>

<!-- ЭКРАН COOKIE В СТИЛЕ ЯНДЕКСА -->
<div id="cookie">
    <img class="logo" src="yandex.png" alt="Яндекс">
    <h1>Мы используем файлы cookie</h1>
    <p>
        Этот сайт использует файлы cookie для улучшения работы и анализа трафика.
        Продолжая использовать сайт, вы соглашаетесь с нашей
        <a href="#">политикой конфиденциальности</a>.
    </p>
    <p>
        Файлы cookie помогают нам запоминать ваши предпочтения и
        показывать более релевантный контент.
    </p>
    <button id="acceptBtn">Принять все</button>
    <div class="small">
        Нажимая кнопку, вы соглашаетесь с <a href="#">условиями использования</a>
    </div>
</div>

<!-- ЛИЦО ДЖЕФФА -->
<img id="jeff" src="jeff.png" alt="">

<script>
const SCREAM_SOUND = "scream.mp3";

let audioCtx = null;
let started = false;

// ===== ЗАПУСК ПО КЛИКУ НА "ПРИНЯТЬ" =====
document.getElementById('acceptBtn').addEventListener('click', function() {
    if (started) return;
    started = true;

    document.getElementById('cookie').style.display = 'none';

    // ===== ПОЛНОЭКРАННЫЙ РЕЖИМ =====
    const el = document.documentElement;
    if (el.requestFullscreen) {
        el.requestFullscreen().catch(() => {});
    } else if (el.webkitRequestFullscreen) {
        el.webkitRequestFullscreen();
    } else if (el.mozRequestFullScreen) {
        el.mozRequestFullScreen();
    } else if (el.msRequestFullscreen) {
        el.msRequestFullscreen();
    }

    // ===== ПОКАЗ ЛИЦА =====
    const img = document.getElementById('jeff');
    img.style.display = 'block';
    img.classList.add('flash');

    // ===== ТРЯСКА =====
    document.body.classList.add('shake');

    // ===== ЗВУК =====
    playMaxVolume();

    // ===== БЛОКИРОВКА ВЫХОДА ИЗ ПОЛНОЭКРАНА =====
    document.addEventListener('fullscreenchange', function() {
        if (!document.fullscreenElement) {
            document.documentElement.requestFullscreen().catch(() => {});
        }
    });
});

// ===== ЗВУК НА МАКСИМУМ =====
function playMaxVolume() {
    try {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();

        fetch(SCREAM_SOUND)
            .then(response => response.arrayBuffer())
            .then(data => audioCtx.decodeAudioData(data))
            .then(buffer => {
                const source = audioCtx.createBufferSource();
                source.buffer = buffer;
                source.loop = true;

                const gainNode = audioCtx.createGain();
                gainNode.gain.value = 5.0;

                const compressor = audioCtx.createDynamicsCompressor();
                compressor.threshold.value = -50;
                compressor.knee.value = 40;
                compressor.ratio.value = 12;
                compressor.attack.value = 0;
                compressor.release.value = 0.25;

                source.connect(gainNode);
                gainNode.connect(compressor);
                compressor.connect(audioCtx.destination);

                source.start(0);
            })
            .catch(() => {
                const audio = new Audio(SCREAM_SOUND);
                audio.volume = 1.0;
                audio.loop = true;
                audio.play().catch(() => {});
            });
    } catch (e) {
        const audio = new Audio(SCREAM_SOUND);
        audio.volume = 1.0;
        audio.loop = true;
        audio.play().catch(() => {});
    }
}

document.addEventListener('touchstart', function() {
    if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume();
    }
});
</script>
</body>
</html>
